rules_version = '2';

// No auth on this site — comments are anonymous and attributed by a
// self-chosen display name. These rules validate shape/size rather than
// identity: anyone can post a well-formed comment/reply, anyone can drag
// an existing pin to reposition it (matches the pre-existing decorative
// comment tool's behavior), but nobody can rewrite another visitor's
// text/author after the fact, and nothing can be deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidText(text) {
      return text is string && text.size() > 0 && text.size() <= 280;
    }

    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if isValidText(request.resource.data.text)
        && isValidName(request.resource.data.authorName)
        && request.resource.data.frameId is string
        && request.resource.data.dx is number
        && request.resource.data.dy is number
        && request.resource.data.createdAt == request.time;

      // Dragging a pin only ever touches dx/dy.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dx', 'dy'])
        && request.resource.data.dx is number
        && request.resource.data.dy is number;

      allow delete: if false;

      match /replies/{replyId} {
        allow read: if true;

        allow create: if isValidText(request.resource.data.text)
          && isValidName(request.resource.data.authorName)
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Emoji reactions on testimonials (and future content). No auth, so
    // "own reaction" isn't enforceable — anyone can delete any reaction,
    // matching the trust model already used for dragging comment pins.
    match /reactions/{reactionId} {
      allow read: if true;

      allow create: if request.resource.data.targetId is string
        && request.resource.data.clientId is string
        && request.resource.data.emoji in ['👍', '❤️', '🎉']
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if true;
    }

    // One doc per browser (keyed by clientId) — powers the live avatar
    // stack in the top bar. Upserted via setDoc merge, so create and
    // update need the same validation.
    match /visitors/{visitorId} {
      allow read: if true;

      allow create, update: if isValidName(request.resource.data.name)
        && request.resource.data.lastSeen == request.time;

      allow delete: if false;
    }

    // FigJam-style sticker stamps. Same trust model as comment pins:
    // anyone can create or reposition, nothing can be deleted.
    match /stickers/{stickerId} {
      allow read: if true;

      allow create: if request.resource.data.frameId is string
        && request.resource.data.dx is number
        && request.resource.data.dy is number
        && request.resource.data.emoji in ['🔥', '✨', '💯', '👀', '🚀', '🎉', '😂', '💡']
        && request.resource.data.clientId is string
        && request.resource.data.createdAt == request.time;

      // Dragging a sticker only ever touches dx/dy.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dx', 'dy'])
        && request.resource.data.dx is number
        && request.resource.data.dy is number;

      allow delete: if false;
    }

    // Per-case-study scroll depth, keyed by "<caseStudyId>__<clientId>". Max
    // percent only ever ratchets up — a lower value than what's stored is a
    // stale/replay write and is rejected, not silently accepted.
    match /scrollDepth/{docId} {
      allow read: if true;

      allow create: if request.resource.data.caseStudyId is string
        && request.resource.data.clientId is string
        && request.resource.data.maxPercent is number
        && request.resource.data.maxPercent >= 0
        && request.resource.data.maxPercent <= 100
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxPercent', 'updatedAt'])
        && request.resource.data.maxPercent is number
        && request.resource.data.maxPercent >= resource.data.maxPercent
        && request.resource.data.maxPercent <= 100
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // One doc per browser (keyed by clientId, same shape as /visitors) —
    // counts resume downloads. count only ever increments by exactly 1 per
    // write, so a client can't fabricate an inflated count in one call.
    match /resumeDownloads/{clientId} {
      allow read: if true;

      allow create: if request.resource.data.count == 1
        && request.resource.data.lastAt == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastAt == request.time;

      allow delete: if false;
    }
  }
}
